# Ask Jethro (Gemini) — copy to .env.local and set your key.
# Also set this in the Vercel project Environment Variables for production.
# Get a long-lived key at https://aistudio.google.com/app/apikey (starts with AIza...)
GEMINI_API_KEY=

# Shared Upstash Redis store for Medical Akinator learning, anonymous IQ test
# results, MedMath sessions, and ABG Arena player ratings. Without
# these, persistent multiplayer features are only in-memory. In Vercel, create an Upstash
# Redis database under Storage and connect it to the project. The variables
# below are injected automatically. Pull them locally with `vercel env pull`.
# Both stores accept either naming convention used by the integration:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (or, if the integration uses the Upstash names instead)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
