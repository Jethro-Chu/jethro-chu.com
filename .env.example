# Ask Jethro (Gemini) — copy to .env.local and set your key.
# Also set this in the Vercel project Environment Variables for production.
# Get a long-lived key at https://aistudio.google.com/app/apikey (starts with AIza...)
GEMINI_API_KEY=

# Shared Upstash Redis store for Medical Akinator learning and anonymous IQ test
# participant results. Without these, Akinator learning is only in-memory and
# IQ participant comparisons are unavailable. In Vercel, create an Upstash
# Redis database under Storage and connect it to the project. The variables
# below are injected automatically. Pull them locally with `vercel env pull`.
# Both stores accept either naming convention used by the integration:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (or, if the integration uses the Upstash names instead)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional IQ submission throttling. Defaults to 5 completed attempts per IP
# per hour. Client addresses are HMAC-hashed before the expiring Redis counter
# is written. Set a separate long random secret to keep that hash independent
# from the Redis token.
IQ_RATE_LIMIT_MAX=5
IQ_RATE_LIMIT_WINDOW_SECONDS=3600
IQ_RATE_LIMIT_SECRET=
